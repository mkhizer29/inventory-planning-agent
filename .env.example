# ─────────────────────────────────────────────────────────────
# Inventory Planning Agent — ETL environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Which source profile to extract from: "staging" or "local_backup"
# (both point at a MySQL server holding the Magento `pg_1` schema)
ETL_SOURCE=staging

# --- Staging source (live Naheed staging DB) ---
STAGING_HOST=34.249.120.145
STAGING_PORT=3306
STAGING_USER=stageusr
STAGING_PASSWORD=
STAGING_DB=pg_1

# --- Local backup source (mark1-bkp.sql loaded into local MySQL) ---
LOCAL_HOST=127.0.0.1
LOCAL_PORT=3306
LOCAL_USER=root
LOCAL_PASSWORD=
LOCAL_DB=pg_1

# --- Target (SQLite warehouse the canonical tables are written to) ---
TARGET_SQLITE_PATH=output/inventory.db
