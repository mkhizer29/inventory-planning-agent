# secrets
.env

# python virtual environment
.venv/

# editable-install / build metadata
*.egg-info/
build/
dist/

# generated ETL outputs (live under inventory_etl/output)
inventory_etl/output/*.db
inventory_etl/output/*.md
inventory_etl/output/csv/

# python caches
__pycache__/
*.pyc
.pytest_cache/

# ── forecasting pilot ──────────────────────────────────────────
# pipeline data is regenerated from code, never committed
data/

# database dumps / archives — but keep the ETL's own query files
*.sql
*.zip
!inventory_etl/etl/sql/*.sql

# model scorecard results (keep the folder via .gitkeep, ignore the CSVs)
outputs/*.csv
!outputs/.gitkeep
