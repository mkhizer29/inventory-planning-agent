# secrets
.env

# python virtual environment
.venv/

# editable-install / build metadata
*.egg-info/
build/
dist/

# generated ETL outputs (everything under inventory_etl/output is regenerated)
inventory_etl/output/

# python caches
__pycache__/
*.pyc
.pytest_cache/

# ── forecasting pilot ──────────────────────────────────────────
# Raw/large pipeline data is regenerated from code, never committed...
data/*
# ...EXCEPT the prepare_pilot outputs — the shared contract all models + the
# dashboard read. Commit these so teammates get them without DB access or the ETL.
# (TrainingData.rar and any other data/ files stay ignored.)
!data/processed/
data/processed/*
!data/processed/model_panel.parquet
!data/processed/forecast_frame.parquet
!data/processed/inventory_context.parquet
!data/processed/pilot_manifest.json

# database dumps / archives — but keep the ETL's own query files
*.sql
*.zip
!inventory_etl/etl/sql/*.sql

# model scorecard results (keep the folder via .gitkeep, ignore the CSVs)
outputs/*.csv
!outputs/.gitkeep
